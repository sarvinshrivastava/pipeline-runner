# Real values come from the secrets manager under the PIPELINE_RUNNER_ prefix;
# vps-deploy strips the prefix and writes .env at deploy time. This file is a
# template only - never put real values here.
#
# NOTE: an unset secret arrives as an EMPTY STRING via docker env_file, not as
# absent, so code must check for "" rather than relying on ?? defaults.

# Bearer token guarding every route except /healthz. 32+ random chars.
API_TOKEN=

# 64 hex chars (32 bytes). Encrypts per-pipeline env vars at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Default git identity/credential for pushing pipeline results.
# Fine-grained PAT with Contents read/write.
GITHUB_TOKEN=
GIT_AUTHOR_NAME=pipeline-runner
GIT_AUTHOR_EMAIL=pipeline-runner@vps.local

# Host path bind-mounted at the identical path inside the container.
HOST_DATA_DIR=/root/pipeline-runner-data

# Read token for the VPS secrets manager, so pipelines can REFERENCE a vault
# key instead of storing the credential here. A read token is sufficient.
SECRET_MANAGER_TOKEN=
# Reached by joining secret-manager's docker network at boot (it binds
# 127.0.0.1 on the host, so host-gateway does not work).
SECRET_MANAGER_URL=http://secret-manager:8000

# ntfy status pings
NTFY_BASE=https://ntfy.sh
NTFY_TOPIC_OK=
NTFY_TOPIC_FAIL=
NTFY_TOKEN=

# Linked from ntfy notifications
DASHBOARD_URL=https://pipeline-runner.vps.sarvinshrivastava.space
