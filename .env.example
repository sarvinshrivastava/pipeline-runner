# Real values come from the secrets manager under the PIPELINE_RUNNER_ prefix;
# vps-deploy strips the prefix and writes .env at deploy time. This file is a
# template only - never put real values here.
#
# NOTE: an unset secret arrives as an EMPTY STRING via docker env_file, not as
# absent; the binary treats "" as unset.

# Bootstrap admin bearer token. 32+ random chars.
API_TOKEN=

# 64 hex chars each (32 bytes). Generate each with: openssl rand -hex 32
# ENCRYPTION_KEY seals container/inline env at rest; RUN_TOKEN_KEY signs the
# per-run tokens async callbacks use. Use two different keys.
ENCRYPTION_KEY=
RUN_TOKEN_KEY=

# Required. The reverse proxy's address as the container sees it: the gateway
# of the app's default network (172.31.250.1 with the compose subnet). Only
# hops from here have X-Forwarded-For honoured. "none" if nothing proxies.
TRUSTED_PROXIES=172.31.250.1

# Host directory mounted at /data, owned by uid 10001 (the deploy workflow
# creates it).
HOST_DATA_DIR=/root/pipeline-runner-data

# Read token for the VPS secrets manager: jobs reference vault keys
# (Folder/KEY) instead of storing credentials here.
SECRET_MANAGER_TOKEN=
# Reached over the secrets-manager_default docker network.
SECRET_MANAGER_URL=http://secret-manager:8000

# ntfy pages
NTFY_BASE=https://ntfy.sh
NTFY_TOPIC_OK=
NTFY_TOPIC_FAIL=
NTFY_TOKEN=

# Uptime Kuma push URL, pinged every 60 s while the engine loop is healthy.
HEARTBEAT_URL=

# Linked from ntfy pages
DASHBOARD_URL=https://pipeline-runner.vps.sarvinshrivastava.space

# Optional tuning (defaults shown)
# PORT=3000
# METRICS_PORT=9464
# MAX_HTTP_INFLIGHT=64
# MAX_HTTP_INFLIGHT_PER_CLIENT=16   # one client's share of those slots; 0 = no cap
# MAX_PENDING_PER_CLIENT=1000       # invoke/ad hoc runs in flight per client (incl. retries) before 429; 0 = no limit
# RUN_RETENTION_DAYS=60

# Delivery 1b (container and inline targets); ignored by this build.
# ENABLE_CONTAINER_TARGETS=false
# GITHUB_TOKEN=
# GIT_TOKEN_HOSTS=github.com
# GIT_AUTHOR_NAME=pipeline-runner
# GIT_AUTHOR_EMAIL=pipeline-runner@vps.local
